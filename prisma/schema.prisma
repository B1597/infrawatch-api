generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Node {
  id       String  @id @default(uuid())
  name     String
  type     String
  status   String
  parentId String?
  location String?
  ipAddress String?
  floor    String?

  parent   Node?   @relation("NodeHierarchy", fields: [parentId], references: [id])
  children Node[]  @relation("NodeHierarchy")

  config   NodeConfig?
  metrics  NodeMetrics?

  createdAt DateTime @default(now())
}

model NodeConfig {
  id             String  @id @default(uuid())
  nodeId         String  @unique
  password       String?
  registrationId String?
  macAddress     String?

  node   Node   @relation(fields: [nodeId], references: [id])
}

model NodeMetrics {
  id      String @id @default(uuid())
  nodeId  String @unique
  cpu     Float?
  memory  Float?
  network Float?
  storage Float?
  uptime  String?

  node   Node   @relation(fields: [nodeId], references: [id])
}
