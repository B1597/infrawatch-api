generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Node {
  id              String  @id @default(uuid())
  name            String
  type            String
  status          String
  parentId        String?
  location        String?
  ipAddress       String?
  floor           String?
  vendor          String?
  serialNumber    String?
  cpuCores        Int?
  memoryCapacity  String?
  storageCapacity String?
  firmware        String?
  cpuUsage        Float?
  memoryUsage     Float?
  networkUsage    Float?
  storageUsage    Float?
  networkIO       String?
  networkOut      String?
  uptimeDays      Int?
  availability    String?

  parent   Node?   @relation("NodeHierarchy", fields: [parentId], references: [id])
  children Node[]  @relation("NodeHierarchy")

  metrics  NodeMetrics?
  config   NodeConfig?

  createdAt DateTime @default(now())
}

model NodeMetrics {
  id     String @id @default(uuid())
  nodeId String @unique
  data   Json

  node   Node   @relation(fields: [nodeId], references: [id])
}

model NodeConfig {
  id             String  @id @default(uuid())
  nodeId         String  @unique
  password       String?
  registrationId String?
  macAddress     String?

  node   Node   @relation(fields: [nodeId], references: [id])
}


model Alert {
  id             String   @id @default(uuid())
  title          String
  message        String
  severity       String   // 'critical' | 'warning' | 'info'
  status         String   // 'active' | 'acknowledged' | 'resolved'
  source         String
  deviceType     String
  category       String
  timestamp      DateTime
  acknowledgedBy String?
  createdAt      DateTime @default(now())
}
